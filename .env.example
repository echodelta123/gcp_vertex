# ─────────────────────────────────────────────────
# Vertex AI Customer Demo — Environment Variables
# ─────────────────────────────────────────────────
# Copy this to .env:  cp .env.example .env
# The project runs fully in DEMO_MODE without any API keys.

# ─── Demo Mode ───────────────────────────────────
# "true"  = Rich mock responses, no API keys needed (default)
# "false" = Live Gemini API calls (requires GEMINI_API_KEY)
DEMO_MODE=true

# ─── Google Gemini API ───────────────────────────
# Free API key: https://aistudio.google.com/apikey
# 15 RPM / 1M TPM free tier on Gemini Flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Model Backend ───────────────────────────────
# Select AI backend: GEMINI (default), OLLAMA (local), BISON (Vertex AI)
MODEL_BACKEND=GEMINI

# ─── Ollama (local LLM — optional) ──────────────
# Only needed if MODEL_BACKEND=OLLAMA
OLLAMA_MODEL=mistral:7b-instruct-q4_K_M
OLLAMA_ENDPOINT=http://localhost:11434/api/generate

# ─── Google Cloud (optional — for Vertex AI SDK) ─
# Only needed if migrating from google-generativeai → vertexai SDK
GCP_PROJECT=
GCP_LOCATION=us-central1

# ─── Neo4j Aura Free (Demo 4 — Graph Explorer) ──
# Free cloud graph: https://neo4j.com/cloud/aura-free/
# Leave NEO4J_PASSWORD empty to use the in-memory mock graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ─── Weaviate (Demo 3 — Customer 360 RAG) ───────
# Used as the primary vector store for interaction retrieval
# Falls back to in-memory LanceDB if unavailable
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# ─── Server ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://localhost:8502,http://localhost:8503,http://localhost:8504,http://localhost:3000
USE_VERTEX_VECTOR_SEARCH=false
